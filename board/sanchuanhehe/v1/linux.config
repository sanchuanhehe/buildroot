CONFIG_SYSVIPC=y                # 支持System V IPC（进程间通信）
CONFIG_MODULES=y                # 支持内核模块
CONFIG_MODULE_UNLOAD=y          # 允许卸载内核模块
# CONFIG_SMP=y                    # 支持多核处理（对称多处理）
# CONFIG_HYPERVISOR_GUEST=y     # 作为虚拟机客户机支持（已禁用）
# CONFIG_PARAVIRT=y             # 半虚拟化支持（已禁用）
CONFIG_EFI=y                    # 支持EFI（可扩展固件接口）
CONFIG_NET=y                    # 启用网络支持
CONFIG_PACKET=y                 # 支持数据包套接字
CONFIG_UNIX=y                   # 支持UNIX域套接字
CONFIG_INET=y                   # 支持IPv4协议栈
CONFIG_NETFILTER=y              # 启用网络过滤框架
CONFIG_IP_NF_IPTABLES=y         # 支持iptables（IPv4包过滤）
CONFIG_IP_NF_FILTER=y           # 支持iptables过滤表
# CONFIG_CFG80211=m             # 无线配置API（已禁用为模块）
# CONFIG_CFG80211_WEXT=y        # 无线扩展支持（已禁用）
# CONFIG_MAC80211=m             # 通用WiFi协议栈（已禁用为模块）
CONFIG_PCI=y                    # 支持PCI总线
CONFIG_DEVTMPFS=y               # 启用设备临时文件系统
CONFIG_DEVTMPFS_MOUNT=y         # 启动时自动挂载devtmpfs
# CONFIG_VIRTIO_BLK=y             # 支持Virtio块设备
CONFIG_BLK_DEV_SD=y             # 支持SCSI磁盘
# CONFIG_SCSI_VIRTIO=y            # 支持Virtio SCSI设备
CONFIG_ATA=y                    # 支持ATA硬盘
CONFIG_ATA_PIIX=y               # 支持Intel PIIX/ICH SATA控制器
CONFIG_NETDEVICES=y             # 启用网络设备支持
# CONFIG_VIRTIO_NET=y             # 支持Virtio网络设备
CONFIG_ATL2=m                   # Attansic L2以太网驱动（模块）
CONFIG_ATL1=m                   # Attansic L1以太网驱动（模块）
CONFIG_ATL1E=m                  # Attansic L1E以太网驱动（模块）
CONFIG_ATL1C=m                  # Attansic L1C以太网驱动（模块）
CONFIG_ALX=m                    # Atheros ALX以太网驱动（模块）
CONFIG_E100=m                   # Intel PRO/100以太网驱动（模块）
CONFIG_E1000=m                  # Intel PRO/1000以太网驱动（模块）
CONFIG_E1000E=m                 # Intel PRO/1000 PCI-E以太网驱动（模块）
CONFIG_IGB=m                    # Intel IGB千兆以太网驱动（模块）
CONFIG_NE2K_PCI=y               # NE2000兼容PCI以太网卡驱动
CONFIG_8139CP=y                 # Realtek 8139兼容PCI以太网卡驱动
CONFIG_R8169=m                  # Realtek 8169千兆以太网驱动（模块）
# CONFIG_ATH9K=m                # Atheros 802.11n无线驱动（已禁用为模块）
# CONFIG_ATH9K_HTC=m            # Atheros HTC无线驱动（已禁用为模块）
# CONFIG_CARL9170=m             # Atheros AR9170无线驱动（已禁用为模块）
# CONFIG_ATH10K=m               # Atheros 802.11ac无线驱动（已禁用为模块）
# CONFIG_ATH10K_PCI=m           # Atheros 802.11ac PCI驱动（已禁用为模块）
# CONFIG_IWL4965=m              # Intel 4965无线驱动（已禁用为模块）
# CONFIG_IWL3945=m              # Intel 3945无线驱动（已禁用为模块）
# CONFIG_IWLWIFI=m              # Intel无线驱动（已禁用为模块）
# CONFIG_RT2X00=m               # Ralink无线驱动（已禁用为模块）
# CONFIG_RT2800PCI=m            # Ralink 2800 PCI无线驱动（已禁用为模块）
# CONFIG_RT73USB=m              # Ralink 73 USB无线驱动（已禁用为模块）
# CONFIG_RT2800USB=m            # Ralink 2800 USB无线驱动（已禁用为模块）
# CONFIG_RT2800USB_RT3573=y     # Ralink 3573 USB支持（已禁用）
# CONFIG_RT2800USB_RT53XX=y     # Ralink 53XX USB支持（已禁用）
# CONFIG_RT2800USB_RT55XX=y     # Ralink 55XX USB支持（已禁用）
# CONFIG_RTL_CARDS is not set   # Realtek无线卡驱动（未设置）
CONFIG_RTL8XXXU=m               # Realtek 8xxx USB无线驱动（模块）
CONFIG_INPUT_EVDEV=y            # 支持evdev输入事件接口
CONFIG_SERIAL_8250=y            # 支持8250/16550串口
CONFIG_SERIAL_8250_CONSOLE=y    # 8250串口作为控制台
# CONFIG_VIRTIO_CONSOLE=y         # 支持Virtio控制台
# CONFIG_HW_RANDOM_VIRTIO=m       # Virtio硬件随机数生成器（模块）
# CONFIG_DRM=y                    # 支持Direct Rendering Manager（显卡渲染管理）
# CONFIG_DRM_I915=y               # Intel集成显卡驱动
# CONFIG_DRM_QXL=y              # QXL虚拟GPU驱动（已禁用）
# CONFIG_DRM_BOCHS=y            # Bochs虚拟GPU驱动（已禁用）
# CONFIG_DRM_VIRTIO_GPU=y       # Virtio GPU驱动（已禁用）
CONFIG_FB=y                     # 支持帧缓冲设备
CONFIG_FIRMWARE_EDID=y          # 支持固件EDID
CONFIG_FB_VESA=y                # 支持VESA帧缓冲
CONFIG_FB_EFI=y                 # 支持EFI帧缓冲
# CONFIG_SOUND=y                # 声卡支持（已禁用）
# CONFIG_SND=y                  # ALSA声音系统（已禁用）
# CONFIG_SND_HDA_INTEL=y        # Intel HDA声卡驱动（已禁用）
# CONFIG_SND_HDA_GENERIC=y      # 通用HDA声卡驱动（已禁用）
CONFIG_USB=y                    # 支持USB
CONFIG_USB_XHCI_HCD=y           # 支持USB 3.0控制器
CONFIG_USB_EHCI_HCD=y           # 支持USB 2.0控制器
CONFIG_USB_UHCI_HCD=y           # 支持USB 1.1控制器
CONFIG_USB_STORAGE=y            # 支持USB存储设备
# CONFIG_VIRTIO_PCI=y           # Virtio PCI支持（已禁用）
# CONFIG_VIRTIO_BALLOON=y       # Virtio内存气球驱动（已禁用）
# CONFIG_VIRTIO_INPUT=y         # Virtio输入设备驱动（已禁用）
# CONFIG_VIRTIO_MMIO=y          # Virtio MMIO支持（已禁用）
# CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y # Virtio MMIO命令行设备（已禁用）
CONFIG_EXT4_FS=y                # 支持EXT4文件系统
# CONFIG_FUSE_FS=y                # 支持FUSE用户空间文件系统
# CONFIG_TMPFS_POSIX_ACL=y        # TMPFS支持POSIX ACL
# CONFIG_SQUASHFS=y               # 支持SquashFS只读文件系统
CONFIG_UNWINDER_FRAME_POINTER=y # 使用帧指针进行栈回溯
# CONFIG_INITRAMFS_SOURCE="${BR_BINARIES_DIR}/rootfs.cpio" # 初始RAM文件系统（已禁用）
CONFIG_BLK_DEV_INITRD=y         # 支持初始RAM磁盘
CONFIG_VT=y                     # 支持虚拟终端
CONFIG_VT_CONSOLE=y             # 支持虚拟终端控制台
CONFIG_HW_CONSOLE=y             # 支持硬件控制台
CONFIG_FRAMEBUFFER_CONSOLE=y    # 支持帧缓冲控制台